---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage: string;
  ogImageAlt: string;
}

const { title, description, ogImage, ogImageAlt } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(`${base}${ogImage.replace(/^\/+/, '')}`, Astro.site).href;
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'PV Asset Auditor',
  description,
  inLanguage: 'pl-PL',
  educationalLevel: 'Od podstawowego do eksperckiego',
  timeRequired: 'PT220H',
  url: canonical,
});
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0d171b" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="PV Asset Auditor Academy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script type="application/ld+json" set:html={structuredData} />
  </head>
  <body>
    <a class="skip-link" href="#tresc">Przejdź do treści</a>
    <main id="tresc"><slot /></main>
  </body>
</html>
