---
import CourseLayout from '../layouts/CourseLayout.astro';
import PvSystemLab from '../components/PvSystemLab.astro';
import GuidedCourse from '../components/GuidedCourse.astro';
import courseSource from '../content/pv-asset-auditor.md?raw';
import { courseStages, quizzes, splitCourseContent } from '../lib/course.mjs';
import { renderCourseMarkdown } from '../lib/course-renderer.mjs';
import '../styles/course.css';
import 'katex/dist/katex.min.css';

const withBase = (assetPath) => `${import.meta.env.BASE_URL}${assetPath.replace(/^\/+/, '')}`;

const sections = splitCourseContent(courseSource).map((section, stageIndex) => {
  const toc = [...section.markdown.matchAll(/^##+\s+(.+)$/gm)].map((match, index) => ({
    label: match[1].replace(/[*`]/g, ''),
    href: `#stage-${stageIndex}-heading-${index}`,
  }));
  return { ...section, html: renderCourseMarkdown(section.markdown), toc };
});

const clientData = JSON.stringify({ courseStages, quizzes }).replace(/</g, '\\u003c');
---
<CourseLayout
  title="PV Asset Auditor | Interaktywna Akademia"
  description="Prowadzona nauka od podstaw elektryczności i PV po inspekcje UAV, termowizję i mapowanie. Przykłady, ćwiczenia, quizy i własny dziennik pracy."
  ogImage="assets/course/hero.webp"
  ogImageAlt="Farma fotowoltaiczna w widoku RGB i termicznym"
>
  <div class="academy" data-course-theme="system">
    <section class="course-hero" aria-labelledby="course-title">
      <img class="course-hero__image" src={withBase('assets/course/hero.webp')} alt="Farma PV podczas radiometrycznej inspekcji dronem, zestawienie RGB i termiki" width="1674" height="943" fetchpriority="high" />
      <div class="course-hero__veil"></div>
      <div class="thermal-scan" aria-hidden="true"></div>
      <div class="course-hero__content wrap">
        <div class="course-topline">
          <p class="course-kicker">PV Asset Auditor Academy <span>Elektryczność · PV · UAV · GIS</span></p>
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="Zmień motyw kursu">Motyw: system</button>
        </div>
        <div class="course-hero__copy">
          <p class="course-overline">Od zera · 18 lekcji · trzy ścieżki praktyczne</p>
          <h1 id="course-title">PV Asset <em>Auditor</em></h1>
          <p class="course-intro">Zrozum prąd, poznaj instalację PV i naucz się pracować z obrazem termicznym oraz mapą. Krok po kroku: objaśnienie, przykład, własne zadanie i informacja zwrotna. Wiedzę utrwalisz w dzienniku, do którego zawsze możesz wrócić.</p>
          <div class="hero-actions">
            <a class="course-button course-button--primary" href="#guided-learning">Zacznij naukę <span aria-hidden="true">↗</span></a>
            <a class="course-button course-button--ghost" href="#program">Podręcznik pogłębiony</a>
          </div>
        </div>
        <dl class="hero-stats" aria-label="Parametry programu">
          <div><dt>18</dt><dd>odrębnych lekcji</dd></div>
          <div><dt>18</dt><dd>rezultatów własnej pracy</dd></div>
          <div><dt>3</dt><dd>dziedziny połączone w praktyce</dd></div>
          <div><dt>100%</dt><dd>krytycznych pytań safety</dd></div>
        </dl>
      </div>
    </section>

    <GuidedCourse />

    <section class="course-principle wrap" aria-labelledby="principle-title">
      <div>
        <p class="course-overline">Zasada nadrzędna</p>
        <h2 id="principle-title">Termogram jest <em>obserwacją</em>, nie diagnozą.</h2>
      </div>
      <p>Każdy wniosek musi przejść przez kontrolowane pozyskanie danych, hipotezy różnicowe, badanie potwierdzające, niepewność oraz ocenę techniczno-finansową.</p>
    </section>

    <section class="chain-section" aria-labelledby="chain-title">
      <div class="wrap">
        <p class="course-overline">Łańcuch dowodowy</p>
        <h2 id="chain-title">Od sygnału do decyzji bez skrótów</h2>
        <div class="evidence-chain" role="list">
          {['Fizyka i topologia', 'SCADA i warunki', 'RGB + IR', 'Ground truth', 'Strata + niepewność', 'Ryzyko + NPV'].map((label, index) => (
            <div class="evidence-node" role="listitem"><span>{String(index + 1).padStart(2, '0')}</span><strong>{label}</strong></div>
          ))}
        </div>
      </div>
    </section>

    <PvSystemLab />

    <details class="reference-library" id="program">
      <summary class="wrap">Podręcznik pogłębiony PV <span>Otwórz siedem części referencyjnych i dodatkowe quizy</span></summary>
    <section class="program-section wrap" aria-labelledby="program-title">
      <div class="program-heading">
        <div>
          <p class="course-overline">Program</p>
          <h2 id="program-title">Siedem części podręcznika</h2>
        </div>
        <p>To materiał do dalszego studiowania po ścieżce podstawowej. Quizy sprawdzają rozumienie podręcznika. Prace terenowe i ocena instruktora wymagają odrębnej organizacji.</p>
      </div>
      <div class="program-grid">
        {courseStages.map((stage, index) => (
          <article class="program-card">
            <img src={withBase(stage.image)} alt="" width="640" height="360" loading="lazy" />
            <div class="program-card__body">
              <div class="program-card__meta"><span>{stage.eyebrow}</span><span>{stage.kind === 'capstone' ? 'Studium końcowe' : 'Materiał referencyjny'}</span></div>
              <h3>{stage.title}</h3>
              <p>{stage.summary}</p>
              <div class="program-card__level"><span>{String(index).padStart(2, '0')}</span>{stage.level}</div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="learning-app" id="nauka" aria-label="Platforma kursowa">
      <div class="course-shell wrap">
        <aside class="course-sidebar" aria-label="Etapy kursu">
          <div class="progress-card">
            <div class="progress-ring" data-progress-ring style="--progress: 0%"><span data-progress-value>0%</span></div>
            <div><strong>Twój postęp</strong><span><b data-hours-complete>0</b> z 7 części</span></div>
          </div>
          <nav class="stage-nav">
            {courseStages.map((stage, index) => (
              <button type="button" data-stage-trigger={stage.id} aria-current={index === 0 ? 'step' : undefined} disabled={index > 0}>
                <span class="stage-nav__index">{index > 0 ? '🔒' : '00'}</span>
                <span><small>{stage.eyebrow}</small><strong>{stage.title}</strong></span>
                <span class="stage-nav__status">{index === 0 ? 'Start' : 'Zablokowany'}</span>
              </button>
            ))}
          </nav>
          <button class="reset-progress" type="button" data-reset-progress>Wyzeruj postęp</button>
        </aside>

        <div class="course-workspace">
          {sections.map((section, index) => {
            const stage = courseStages[index];
            const quiz = quizzes[stage.id];
            return (
              <article class="course-stage" data-course-stage={stage.id} hidden={index !== 0}>
                <header class="stage-header">
                  <div class="stage-header__copy">
                    <p class="course-overline">{stage.eyebrow} · {stage.level}</p>
                    <h2>{stage.title}</h2>
                    <p>{stage.summary}</p>
                    <ul>{stage.outcomes.map((outcome) => <li>{outcome}</li>)}</ul>
                  </div>
                  <figure><img src={withBase(stage.image)} alt="" width="960" height="540" loading="lazy" /><figcaption>Materiał ilustracyjny. Wnioski opieraj na danych źródłowych i QA.</figcaption></figure>
                </header>

                <details class="stage-toc">
                  <summary>Spis lekcji tego etapu</summary>
                  <ol>{section.toc.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ol>
                </details>

                <div class="source-preserved"><span aria-hidden="true">✓</span><div><strong>Podręcznik do pogłębienia wiedzy</strong><p>Dawny plan 220 godzin obejmuje także projektowane zajęcia z instruktorem i teren. Nie jest czasem nauki potwierdzonym przez tę platformę. Procedury czytaj w granicach swoich kwalifikacji.</p></div></div>
                <div class="course-prose" set:html={section.html}></div>

                <section class="quiz" data-quiz={stage.id} aria-labelledby={`quiz-title-${stage.id}`}>
                  <div class="quiz__heading">
                    <div><p class="course-overline">Sprawdź zrozumienie</p><h2 id={`quiz-title-${stage.id}`}>Quiz: {stage.title}</h2></div>
                    <span>Próg: {Math.round(quiz.passingScore * 100)}%</span>
                  </div>
                  <form>
                    {quiz.questions.map((item, questionIndex) => (
                      <fieldset data-quiz-question={questionIndex}>
                        <legend><span>{String(questionIndex + 1).padStart(2, '0')}</span>{item.prompt}</legend>
                        <div class="quiz-options">
                          {item.options.map((option, optionIndex) => (
                            <label class="quiz-option"><input type="radio" name={`q-${stage.id}-${questionIndex}`} value={optionIndex} /><span>{option}</span></label>
                          ))}
                        </div>
                        <p class="quiz-feedback" hidden></p>
                      </fieldset>
                    ))}
                    <button class="course-button course-button--primary" type="submit">Sprawdź odpowiedzi</button>
                    <p class="quiz-result" aria-live="polite"></p>
                  </form>
                </section>
              </article>
            );
          })}

          <section class="certificate" data-certificate hidden aria-labelledby="certificate-title">
            <p class="course-overline">Ścieżka ukończona</p>
            <h2 id="certificate-title">Quizy podręcznika ukończone</h2>
            <p>Rozwiązałeś quizy siedmiu części. Ten zapis nie potwierdza wykonania pomiarów, praktyki terenowej ani obrony audytu.</p>
            <dl><div><dt>Tryb</dt><dd>Samokształcenie</dd></div><div><dt>Etapy</dt><dd>7 / 7</dd></div><div><dt>Standard</dt><dd>Evidence-first</dd></div></dl>
            <button class="course-button course-button--ghost" type="button" data-print-certificate>Drukuj potwierdzenie</button>
          </section>
        </div>
      </div>
    </section>
    </details>
  </div>
  <script type="application/json" id="course-data" set:html={clientData}></script>
  <script>
    import { initializeCourse } from '../lib/course-client.mjs';
    initializeCourse();
  </script>
</CourseLayout>
